# Copy to .env and fill in. Never commit .env.

# API key issued by your EVREN LLM Gateway account.
EVREN_API_KEY=

# Gateway address (OpenAI-compatible, ends with /v1). Deployment specific, so there is no default.
EVREN_BASE_URL=https://<your-gateway-host>/v1

# Model used when none is chosen with --model or in settings.
EVREN_DEFAULT_MODEL=qwen3-vl-30b

# Optional: upper bound for tokens in one model reply (empty = gateway default).
EVREN_DEFAULT_MAX_TOKENS=

# Optional: cheaper model for context summaries (defaults to the main model).
# EVREN_FAST_MODEL=

# Optional: interface language, tr or en (default: from the system locale, else tr).
# USTA_LANG=
